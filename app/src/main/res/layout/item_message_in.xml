<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_in"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/message_text"
            style="@style/TextAppearance.Circle.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:maxWidth="280dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/message_time"
            style="@style/TextAppearance.Circle.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</FrameLayout>
