<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Circle">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.post.PostDetailActivity"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.post.CreatePostActivity"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.chat.NewChatActivity"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.admin.AdminActivity"
            android:parentActivityName=".ui.main.MainActivity" />
    </application>

</manifest>
